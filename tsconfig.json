{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "declaration": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node", "bun"]
  },
  "include": ["src/**/*", "scripts/**/*", "e2e/**/*", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
